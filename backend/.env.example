# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LLM Configuration
GEMINI_API_KEY=your_gemini_api_key

# Browserbase Configuration (optional, for stealth browsing at scale)
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO

# Audit Configuration
AUDIT_PROFILE=standard
MAX_PAGES_PER_AUDIT=500
BFS_TIMEOUT_SECONDS=1800
PAGE_LOAD_TIMEOUT_MS=30000
POST_LOAD_IDLE_MS=3000
INTERACTION_TIMEOUT_MS=300
LOADING_STATE_THRESHOLD_MS=300
PERFORMANCE_BASELINE_THRESHOLD_MS=2000
PIPELINE_ANALYSIS_CONCURRENCY=2
SITEMAP_MAX_URLS=50
ENABLE_HEAD_PREFLIGHT=true
MAX_GEMINI_CALLS_PER_AUDIT=0
GEMINI_MAX_RETRIES=3
ENABLE_LLM_ANALYSIS=true
ENABLE_SCREENSHOTS=true
ENABLE_PERSONAS=true

# Database
DATABASE_URL=your_database_url
